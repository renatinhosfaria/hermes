# Hermes home is a live runtime directory. Ignore everything by default and
# opt in only files that are intentionally safe to audit in Git.
*

# Repository policy
!/.gitignore
!/.gitattributes
!/.env.example
!/VERSIONAMENTO.md

# Root-level declarative customization
!/SOUL.md
!/.hermes.md
!/config.yaml
!/profile.yaml

# Profile definitions. Credentials and runtime data below each profile remain
# ignored because only these explicit files are re-included.
!/profiles/
!/profiles/*/
!/profiles/*/.env.example
!/profiles/*/SOUL.md
!/profiles/*/.hermes.md
!/profiles/*/config.yaml
!/profiles/*/profile.yaml
!/profiles/*/.no-bundled-skills

# Profile-local runtime skills. Each path is explicit so bundled skills under
# profiles/dev/skills remain excluded.
!/profiles/cadastro/skills/
!/profiles/cadastro/skills/business-operations/
!/profiles/cadastro/skills/business-operations/fama-cadastro-runtime/
!/profiles/cadastro/skills/business-operations/fama-cadastro-runtime/**
!/profiles/dev/skills/
!/profiles/dev/skills/business-operations/
!/profiles/dev/skills/business-operations/fama-dev-runtime/
!/profiles/dev/skills/business-operations/fama-dev-runtime/**
!/profiles/famaagent/skills/
!/profiles/famaagent/skills/business-operations/
!/profiles/famaagent/skills/business-operations/fama-corretor-runtime/
!/profiles/famaagent/skills/business-operations/fama-corretor-runtime/**
!/profiles/porteiro/skills/
!/profiles/porteiro/skills/business-operations/
!/profiles/porteiro/skills/business-operations/fama-porteiro-runtime/
!/profiles/porteiro/skills/business-operations/fama-porteiro-runtime/**
!/profiles/reno/skills/
!/profiles/reno/skills/business-operations/
!/profiles/reno/skills/business-operations/fama-reno-runtime/
!/profiles/reno/skills/business-operations/fama-reno-runtime/**

# Locally authored skills and bundled skills with deliberate local changes.
# Parent categories are opened only so Git can reach these exact directories.
!/skills/
!/skills/autonomous-ai-agents/
!/skills/autonomous-ai-agents/hermes-agent/
!/skills/autonomous-ai-agents/hermes-agent/**
!/skills/autonomous-ai-agents/hermes-kanban-operations/
!/skills/autonomous-ai-agents/hermes-kanban-operations/**
!/skills/autonomous-ai-agents/kanban-worker-resilience/
!/skills/autonomous-ai-agents/kanban-worker-resilience/**
!/skills/business-operations/
!/skills/business-operations/fama-ceo-runtime/
!/skills/business-operations/fama-ceo-runtime/**
!/skills/devops/
!/skills/devops/hermes-profile-review/
!/skills/devops/hermes-profile-review/**

# User-authored operational documentation and automation.
!/docs/
!/docs/**
!/ops/
!/ops/**
