# Hermes home is a live runtime directory. Ignore everything by default and
# opt in only files that are intentionally safe to audit in Git.
*

# Repository policy
!/.gitignore
!/.gitattributes
!/.env.example
!/VERSIONAMENTO.md

# Root-level declarative customization
!/SOUL.md
!/.hermes.md
!/config.yaml
!/profile.yaml

# Profile definitions. Credentials and runtime data below each profile remain
# ignored because only these explicit files are re-included.
!/profiles/
!/profiles/*/
!/profiles/*/.env.example
!/profiles/*/SOUL.md
!/profiles/*/.hermes.md
!/profiles/*/config.yaml
!/profiles/*/profile.yaml
!/profiles/*/.no-bundled-skills

# Skills: todas as skills do CEO e dos profiles são versionadas.
# O deny-all acima é reaberto em cascata antes do conteúdo das skills.
!/skills/
!/skills/**
!/profiles/*/skills/
!/profiles/*/skills/**
# Skills customizadas e empacotadas entram no repositório; skills novas
# semeadas pelo Hermes devem ser auditadas e commitadas normalmente.

# Hermes bookkeeping and generated dependency/cache artifacts are not skill
# source and remain excluded even inside the opened trees above.
/skills/.bundled_manifest
/skills/.usage.json
/skills/.usage.json.lock
/skills/.curator_state
/skills/.curator_ledger.jsonl
/skills/.curator_suppressed
/skills/.curator_backups/
/skills/.hub/
/profiles/*/skills/.bundled_manifest
/profiles/*/skills/.usage.json
/profiles/*/skills/.usage.json.lock
/profiles/*/skills/.curator_state
/profiles/*/skills/.curator_ledger.jsonl
/profiles/*/skills/.curator_suppressed
/profiles/*/skills/.curator_backups/
/profiles/*/skills/.hub/
/skills/**/__pycache__/
/skills/**/*.pyc
/skills/**/node_modules/
/skills/**/.venv/
/profiles/*/skills/**/__pycache__/
/profiles/*/skills/**/*.pyc
/profiles/*/skills/**/node_modules/
/profiles/*/skills/**/.venv/

# User-authored operational documentation and automation.
!/docs/
!/docs/**
!/ops/
!/ops/**

# Scripts de fonte para jobs de cron. O Hermes exige que --monitor-script e
# --script vivam sob <HERMES_HOME>/scripts/ (hermes_cli/cron.py:564, validado
# com path.relative_to), então a automação não pode morar em ops/. Entram no
# repositório pelo mesmo motivo que ops/: são automação escrita por nós.
!/scripts/
!/scripts/**
!/profiles/*/scripts/
!/profiles/*/scripts/**
