# Hermes home is a live runtime directory. Ignore everything by default and
# opt in only files that are intentionally safe to audit in Git.
*

# Repository policy
!/.gitignore
!/.gitattributes
!/.env.example
!/VERSIONAMENTO.md

# Root-level declarative customization
!/SOUL.md
!/.hermes.md
!/config.yaml
!/profile.yaml

# Profile definitions. Credentials and runtime data below each profile remain
# ignored because only these explicit files are re-included.
!/profiles/
!/profiles/*/
!/profiles/*/.env.example
!/profiles/*/SOUL.md
!/profiles/*/.hermes.md
!/profiles/*/config.yaml
!/profiles/*/profile.yaml
!/profiles/*/.no-bundled-skills

# All functional skill content: local, bundled, and Skills Hub installations,
# including references, scripts, templates, and assets.
!/skills/
!/skills/**
!/profiles/*/skills/
!/profiles/*/skills/**

# Hermes bookkeeping and generated dependency/cache artifacts are not skill
# source and remain excluded even inside the opened trees above.
/skills/.bundled_manifest
/skills/.usage.json
/skills/.usage.json.lock
/skills/.curator_state
/skills/.curator_ledger.jsonl
/skills/.curator_suppressed
/skills/.hub/
/profiles/*/skills/.bundled_manifest
/profiles/*/skills/.usage.json
/profiles/*/skills/.usage.json.lock
/profiles/*/skills/.curator_state
/profiles/*/skills/.curator_ledger.jsonl
/profiles/*/skills/.curator_suppressed
/profiles/*/skills/.hub/
/skills/**/__pycache__/
/skills/**/*.pyc
/skills/**/node_modules/
/skills/**/.venv/
/profiles/*/skills/**/__pycache__/
/profiles/*/skills/**/*.pyc
/profiles/*/skills/**/node_modules/
/profiles/*/skills/**/.venv/

# User-authored operational documentation and automation.
!/docs/
!/docs/**
!/ops/
!/ops/**

# Skills: o deny-all acima ignora profiles/*/skills/.
# Skills CUSTOMIZADAS são versionadas por inclusão forçada (git add -f) e
# permanecem rastreadas — .gitignore não afeta arquivo já rastreado.
# Skills EMPACOTADAS com o Hermes (listadas em skills/.bundled_manifest)
# continuam ignoradas: são semeadas pela instalação e reproduzíveis.
